{
  "schemaVersion": 1,
  "defaults": {
    "bind": "127.0.0.1",
    "ownership": "disposable-fixture"
  },
  "fixtures": [
    {
      "id": "static-http",
      "description": "Deterministic HTML response with a title",
      "port": 51739,
      "command": [
        "python3",
        "evaluation/fixtures/http_fixture.py",
        "--host",
        "127.0.0.1",
        "--port",
        "51739"
      ],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "title": "port-tools fixture",
        "requiredEvidence": ["valid-http-response", "html-title"]
      }
    },
    {
      "id": "tcp-echo",
      "description": "Raw TCP listener that echoes bytes and must not appear as Web",
      "port": 51740,
      "command": [
        "python3",
        "evaluation/fixtures/tcp_echo_fixture.py",
        "--host",
        "127.0.0.1",
        "--port",
        "51740"
      ],
      "expected": {
        "classification": "non-web",
        "protocol": "tcp",
        "requiredEvidence": ["invalid-http-response"]
      }
    },
    {
      "id": "self-signed-https",
      "description": "HTTPS service whose local certificate is intentionally untrusted",
      "port": 51741,
      "prepare": "self-signed-certificate",
      "command": [
        "python3",
        "evaluation/fixtures/https_fixture.py",
        "--host",
        "127.0.0.1",
        "--port",
        "51741",
        "--cert",
        "{runtime}/localhost.crt",
        "--key",
        "{runtime}/localhost.key"
      ],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "https",
        "title": "port-tools fixture",
        "requiredEvidence": ["tls-handshake", "valid-http-response", "untrusted-certificate"]
      }
    },
    {
      "id": "vite-hmr",
      "description": "Vite development server with HMR WebSocket",
      "port": 51742,
      "prepare": "npm-install",
      "cwd": "evaluation/fixtures/vite",
      "command": ["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "51742", "--strictPort"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "title": "port-tools Vite fixture",
        "framework": "vite",
        "applicationRoot": "{repo}/evaluation/fixtures/vite",
        "applicationName": "port-tools-vite-fixture",
        "requiredEvidence": ["valid-http-response", "html-title", "vite-client", "websocket-upgrade"]
      }
    },
    {
      "id": "shell-wrapper",
      "description": "Server launched through a shell from outside its Git working directory",
      "port": 51743,
      "command": ["sh", "evaluation/fixtures/shell_wrapper_fixture.sh", "51743"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectRoot": "{repo}",
        "projectEvidence": "command-path",
        "requiredEvidence": ["valid-http-response", "command-path"]
      }
    },
    {
      "id": "worktree-main",
      "description": "Primary worktree of a disposable repository",
      "port": 51744,
      "prepare": "git-worktrees",
      "cwd": "{runtime}/worktree-main",
      "command": ["python3", "http_fixture.py", "--host", "127.0.0.1", "--port", "51744"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectRoot": "{runtime}/worktree-main",
        "branch": "main",
        "requiredEvidence": ["valid-http-response", "git-project"]
      }
    },
    {
      "id": "worktree-feature",
      "description": "Second worktree of the same disposable repository",
      "port": 51745,
      "prepare": "git-worktrees",
      "cwd": "{runtime}/worktree-feature",
      "command": ["python3", "http_fixture.py", "--host", "127.0.0.1", "--port", "51745"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectRoot": "{runtime}/worktree-feature",
        "branch": "fixture-feature",
        "requiredEvidence": ["valid-http-response", "git-project"]
      }
    },
    {
      "id": "docker-http",
      "description": "HTTP service published from a Docker container onto loopback",
      "kind": "docker",
      "port": 51746,
      "containerPort": 80,
      "containerName": "port-tools-fixture-web",
      "image": "nginx:alpine",
      "labels": {
        "com.docker.compose.project": "port-tools",
        "com.docker.compose.project.working_dir": "{repo}",
        "com.docker.compose.service": "web",
        "dev.port-tools.fixture": "docker-http"
      },
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectRoot": "{repo}",
        "managementSource": "docker",
        "projectEvidence": "docker-compose-working-directory",
        "requiredEvidence": ["valid-http-response", "docker-published-port"]
      }
    },
    {
      "id": "next-hmr",
      "description": "Next.js development server with framework HMR",
      "port": 51748,
      "prepare": "npm-install",
      "cwd": "evaluation/fixtures/next",
      "environment": {"NEXT_TELEMETRY_DISABLED": "1"},
      "command": ["npm", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "51748"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "title": "port-tools Next.js fixture",
        "framework": "next",
        "projectRoot": "{repo}",
        "applicationRoot": "{repo}/evaluation/fixtures/next",
        "applicationName": "port-tools-next-fixture",
        "requiredEvidence": ["valid-http-response", "html-title", "next-runtime"]
      }
    },
    {
      "id": "fastapi",
      "description": "FastAPI JSON application served by uvicorn",
      "port": 51749,
      "prepare": "fastapi-venv",
      "cwd": "evaluation/fixtures/fastapi",
      "command": ["{fastapi_python}", "-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "51749"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "framework": "fastapi",
        "projectRoot": "{repo}",
        "requiredEvidence": ["valid-http-response", "json-content-type", "uvicorn-command"]
      }
    },
    {
      "id": "redis",
      "description": "Redis database protocol published onto loopback",
      "kind": "docker",
      "port": 51750,
      "containerPort": 6379,
      "containerName": "port-tools-fixture-redis",
      "image": "redis:7-alpine",
      "labels": {
        "com.docker.compose.project": "port-tools",
        "com.docker.compose.project.working_dir": "{repo}",
        "com.docker.compose.service": "redis",
        "dev.port-tools.fixture": "redis"
      },
      "expected": {
        "classification": "non-web",
        "protocol": "redis",
        "projectRoot": "{repo}",
        "managementSource": "docker",
        "projectEvidence": "docker-compose-working-directory",
        "requiredEvidence": ["redis-response", "docker-published-port"]
      }
    },
    {
      "id": "monorepo-app",
      "description": "Web app nested below a Git worktree in a monorepo-style package directory",
      "port": 51751,
      "cwd": "evaluation/fixtures/monorepo/apps/web",
      "command": ["python3", "../../../http_fixture.py", "--host", "127.0.0.1", "--port", "51751"],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectRoot": "{repo}",
        "applicationRoot": "{repo}/evaluation/fixtures/monorepo/apps/web",
        "applicationName": "@port-tools/monorepo-web",
        "projectEvidence": "cwd",
        "requiredEvidence": ["valid-http-response", "git-project", "application-manifest"]
      }
    },
    {
      "id": "ambiguous-command",
      "description": "Web process whose command references two different Git projects",
      "port": 51752,
      "prepare": "ambiguous-project",
      "cwd": "/tmp",
      "command": [
        "python3",
        "{repo}/evaluation/fixtures/http_fixture.py",
        "--host",
        "127.0.0.1",
        "--port",
        "51752",
        "--identity-path",
        "{runtime}/ambiguity-other/README.md"
      ],
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectAbsent": true,
        "projectCandidateCount": 2,
        "projectEvidence": "ambiguous-command-path",
        "requiredEvidence": ["valid-http-response", "ambiguous-command-path"]
      }
    },
    {
      "id": "docker-http-unlabeled",
      "description": "Unlabeled Docker-published HTTP service that must not inherit the host runtime cwd",
      "kind": "docker",
      "port": 51753,
      "containerPort": 80,
      "containerName": "port-tools-fixture-unlabeled",
      "image": "nginx:alpine",
      "expected": {
        "classification": "confirmed-web",
        "protocol": "http",
        "projectAbsent": true,
        "managementSource": "docker",
        "projectEvidence": "docker-unattributed",
        "requiredEvidence": ["valid-http-response", "docker-published-port"]
      }
    }
  ]
}
