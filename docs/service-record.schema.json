{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Popcornnnnnnnn/port-tools/docs/service-record.schema.json",
  "title": "port-tools scan document",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "host", "services", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "host": { "type": "string" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "project", "application", "serviceIds", "applications"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "project": { "type": ["object", "null"] },
          "application": { "type": ["object", "null"] },
          "applications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "application", "serviceIds"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "application": { "type": ["object", "null"] },
                "serviceIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              }
            }
          },
          "serviceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "listener", "process", "application", "management", "observation", "relevance"],
        "properties": {
          "id": { "type": "string" },
          "listener": {
            "type": "object",
            "required": ["address", "port", "bindScope"],
            "properties": {
              "address": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "bindScope": { "enum": ["loopback", "all-interfaces", "interface"] }
            }
          },
          "process": {
            "type": "object",
            "required": ["pid", "name", "owner"],
            "properties": {
              "pid": { "type": "integer", "minimum": 1 },
              "parentPid": { "type": ["integer", "null"] },
              "name": { "type": ["string", "null"] },
              "owner": { "type": ["string", "null"] },
              "command": { "type": ["string", "null"] },
              "cwd": { "type": ["string", "null"] },
              "started": { "type": ["string", "null"] }
            }
          },
          "project": { "type": ["object", "null"] },
          "application": {
            "type": ["object", "null"],
            "properties": {
              "root": { "type": "string" },
              "relativePath": { "type": "string" },
              "name": { "type": "string" },
              "manifest": { "type": "string" }
            }
          },
          "projectEvidence": { "type": ["string", "null"] },
          "projectCandidates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hostProcessProject": { "type": ["object", "null"] },
          "management": {
            "type": "object",
            "required": ["source"],
            "properties": {
              "source": { "enum": ["unmanaged", "docker", "launchd", "homebrew", "port-tools"] }
            }
          },
          "observation": {
            "type": "object",
            "required": ["classification", "protocol", "confidence", "evidence"],
            "properties": {
              "classification": {
                "enum": ["confirmed-web", "suspected-web", "non-web", "unknown"]
              },
              "protocol": { "enum": ["http", "https", "redis", "tcp", "unknown"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "framework": { "type": ["string", "null"] },
              "http": { "type": "object" },
              "evidence": { "type": "array", "minItems": 1 }
            }
          },
          "relevance": {
            "type": "object",
            "required": ["category", "developerRelevant", "confidence", "evidence"],
            "properties": {
              "category": {
                "enum": ["developer-project", "developer-tool", "developer-container", "unattributed-web-endpoint"]
              },
              "developerRelevant": { "type": "boolean" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    }
  }
}
